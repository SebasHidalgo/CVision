# CVision: every environment variable the deployed app reads, for the
# production project's settings (Vercel > Project > Settings > Environment
# Variables). This file documents; it is never loaded by anything. Keep the
# real values in the host's settings only. The local equivalent, with
# comments on each value, is .env.template.
#
# Columns: SERVICE, PUBLIC (shipped to the browser: only NEXT_PUBLIC_*),
# DIFFERENT IN PRODUCTION (a production value, not the development one).
# Everything is different in production except AI_PROVIDER, AI_MODEL and
# PADDLE_ENV's meaning (it must read "production" there).

# --- App -----------------------------------------------------------------
# Public base URL (metadata base). PUBLIC. Different: the real domain.
NEXT_PUBLIC_APP_URL=https://<domain>
# Vercel cron authentication: a random string of 16+ characters; Vercel
# sends it as "Authorization: Bearer <value>" to the cron route. Secret.
# Different: generated for production.
CRON_SECRET=

# --- Clerk (production instance, pk_live_/sk_live_) -----------------------
# PUBLIC. Different: the production instance's key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# Secret. Different.
CLERK_SECRET_KEY=sk_live_...
# Signing secret of the production webhook endpoint (/api/webhooks/clerk).
# Secret. Different: the production endpoint has its own.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Supabase (production project, Pro plan) ------------------------------
# Transaction pooler, port 6543, with pgbouncer=true&connection_limit=3&pool_timeout=15
# (the Vercel values; see README "Database connections"). Secret. Different.
DATABASE_URL=postgresql://...:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=15
# Session pooler / direct, port 5432: Prisma CLI and scripts only (db:deploy,
# db:bootstrap). Secret. Different. Not needed at runtime on Vercel, but set
# it so `npm run db:bootstrap` can run from a machine with these values.
DIRECT_URL=postgresql://...:5432/postgres
# Project URL. Read on the server only (the prefix is history). Different.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Service role key (Project Settings > API > service_role). Secret. Different.
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs (the production workspace or account) ---------------------
# Key with the permissions the README lists (ConvAI read/write, webhooks
# read/write, user_read). Secret. Different: production's own key.
ELEVENLABS_API_KEY=
# The two agents `npm run agent:sync` creates in production. Different.
ELEVENLABS_AGENT_ID=
ELEVENLABS_TRIAL_AGENT_ID=
# The post-call webhook's secret, printed once by agent:sync. Secret. Different.
ELEVENLABS_WEBHOOK_SECRET=
# Optional: the balance floor in credits (default 12,000; 0 disables).
# ELEVENLABS_BALANCE_FLOOR_CREDITS=

# --- Google AI (Gemini) ---------------------------------------------------
# Same in production.
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite
# A key from a project with Cloud Billing enabled (paid tier: prompts are
# not used to improve Google's products). Secret. Different: production's own.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Paddle (production account, pdl_live_/live_) --------------------------
# MUST be "production" here and nowhere else. No default exists in code.
PADDLE_ENV=production
# Secret. Different: the live key, with every permission the README lists.
PADDLE_API_KEY=pdl_live_...
# PUBLIC. Different: the live client-side token.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
# The three values `npm run billing:sync -- --production` prints. Different.
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_INTERVIEW_PACK=pri_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# --- Security headers ------------------------------------------------------
# Optional: "report-only" or "enforce". Unset: report-only in development,
# enforce in production (lib/securityHeaders.ts).
# CSP_MODE=
