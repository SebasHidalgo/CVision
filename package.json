{
  "name": "cvision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check-rls": "tsx --env-file-if-exists=.env scripts/db/check-rls.ts",
    "user:set-plan": "tsx --env-file-if-exists=.env scripts/db/set-plan.ts",
    "report:guards": "tsx --env-file-if-exists=.env scripts/db/report-guards.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env scripts/eval/run.ts",
    "agent:sync": "tsx --env-file-if-exists=.env scripts/elevenlabs/sync-agent.ts",
    "voice:doctor": "tsx --env-file-if-exists=.env scripts/elevenlabs/doctor.ts",
    "billing:sync": "tsx --conditions=react-server --env-file-if-exists=.env scripts/billing/sync.ts",
    "billing:reconcile": "tsx --conditions=react-server --env-file-if-exists=.env scripts/billing/reconcile.ts",
    "billing:doctor": "tsx --conditions=react-server --env-file-if-exists=.env scripts/billing/doctor.ts",
    "storage:gc": "tsx --conditions=react-server --env-file-if-exists=.env scripts/storage/gc.ts",
    "e2e": "playwright test --project chromium",
    "e2e:voice": "playwright test --project voice",
    "e2e:cleanup": "tsx --conditions=react-server --env-file-if-exists=.env e2e/cleanup.ts",
    "storage:setup": "tsx --conditions=react-server --env-file-if-exists=.env scripts/storage/setup.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/db/bootstrap.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.69",
    "@clerk/nextjs": "^6.39.3",
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@elevenlabs/react": "^1.17.0",
    "@hookform/resolvers": "^5.9.1",
    "@paddle/paddle-js": "^1.6.5",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@prisma/client": "^6.17.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.75.0",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.545.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.3.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.50",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.17.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
