{
  "name": "cvision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check-rls": "tsx --env-file-if-exists=.env scripts/db/check-rls.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env scripts/eval/run.ts",
    "agent:sync": "tsx --env-file-if-exists=.env scripts/elevenlabs/sync-agent.ts",
    "storage:bucket": "tsx --conditions=react-server --env-file-if-exists=.env scripts/storage/bucket-private.ts",
    "storage:gc": "tsx --conditions=react-server --env-file-if-exists=.env scripts/storage/gc.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.69",
    "@clerk/nextjs": "^6.39.3",
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@elevenlabs/react": "^1.17.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.17.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.75.0",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.545.0",
    "next": "15.5.24",
    "next-themes": "^0.4.6",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.3.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "prisma": "^6.17.0",
    "tailwindcss": "^4",
