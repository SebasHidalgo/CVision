datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ResumeAnalysis {
  id             String   @id @default(uuid())
  companyName    String
  jobTitle       String
  jobDescription String
  resumeUrl      String
  userId         String
  createdAt      DateTime @default(now())

  feedback  ResumeFeedback?
  Interview Interview?
}

model ResumeFeedback {
  id                         String         @id @default(uuid())
  resumeId                   String         @unique
  resume                     ResumeAnalysis @relation(fields: [resumeId], references: [id])
  overall                    Json
  atsCompatibility           Json
  experienceAndImpact        Json
  skills                     Json
  educationAndCertifications Json
  toneAndClarity             Json
  jobFit                     Json
}

model Interview {
  id        String   @id @default(uuid())
  role      String
  techstack String[]
  userId    String
  finalized Boolean  @default(false)
  createdAt    DateTime @default(now())
  recordingUrl String?

  resumeAnalysisId String?         @unique // <- conexión opcional al ResumeAnalysis
  resumeAnalysis   ResumeAnalysis? @relation(fields: [resumeAnalysisId], references: [id])

  InterviewFeedback InterviewFeedback?
}

model InterviewFeedback {
  id                  String    @id @default(uuid())
  interviewId         String    @unique
  interview           Interview @relation(fields: [interviewId], references: [id])
  totalScore          Int
  categoryScores      Json
  strengths           String[]
  areasForImprovement String[]
  finalAssessment     String
}
