datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// The plans (lib/plans.ts). Stored only as a manual comp on `User.compPlan`;
/// the plan a user actually has is derived (lib/billing/access.ts).
enum Plan {
  FREE
  PRO
}

/// One row per Clerk account that has touched the app. The id is Clerk's and
/// nothing else about the person is stored. Written by the Clerk webhook
/// (user.created) and, since the webhook may be late or unregistered, by
/// `ensureUser` before any row keyed by `userId` is inserted. Deleting it
/// cascades to every analysis, interview, usage event and billing row of
/// the account.
model User {
  id        String   @id
  /// A plan granted by hand (`npm run user:set-plan`), outside billing: PRO
  /// for the owner and anyone comped. Null for everyone else. The plan in
  /// force is derived: an access-granting subscription, else this, else FREE.
  compPlan  Plan?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyses        ResumeAnalysis[]
  interviews      Interview[]
  usageEvents     UsageEvent[]
  billingCustomer BillingCustomer?
  subscriptions   Subscription[]
}

/// What a usage event paid for, or granted.
///
///   ANALYSIS                one analysis
///   INTERVIEW               a Pro account's interview of the period
///   INTERVIEW_TRIAL         the one free interview of an account that never had voice
///   INTERVIEW_CREDIT        a Pro interview paid with a pack credit, once the period's are used
///   INTERVIEW_CREDIT_GRANT  a pack purchase: `units` credits, `refId` the transaction
///   INTERVIEW_CREDIT_REVOKE a refund or chargeback of a pack: the credits that were
///                           still unused, `refId` the adjustment
enum UsageKind {
  ANALYSIS
  INTERVIEW
  INTERVIEW_TRIAL
  INTERVIEW_CREDIT
  INTERVIEW_CREDIT_GRANT
  INTERVIEW_CREDIT_REVOKE
}

/// The usage ledger. A quota check counts the non-refunded events of a kind
/// in the current period; the check and the insert share one serializable
/// transaction (`reserveUsage`), so two parallel requests cannot both take
/// the last unit. A refund keeps the row and dates it, so the ledger stays
/// an audit trail. Credits are the same ledger: the balance is the grants
/// minus the revokes minus the non-refunded consumption, never a column.
model UsageEvent {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         UsageKind
  /// The analysis or interview the unit was spent on; the transaction of a
  /// grant; the adjustment of a revoke. Unique per kind, which is what makes
  /// a replayed grant or revoke a no-op.
  refId        String
  /// Always 1 for consumption; the credits of a grant or a revoke.
  units        Int       @default(1)
  createdAt    DateTime  @default(now())
  refundedAt   DateTime?
  /// Why it was given back: the error code or the interview's failure reason.
  refundReason String?

  @@unique([kind, refId])
  @@index([userId, kind, createdAt])
}

/// The user's customer record at the billing provider, created from the
/// first event that names both (checkout collects the email; nothing about
/// the person is stored here). One customer per user and one user per
/// customer; the provider is implied by `lib/billing`.
model BillingCustomer {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerCustomerId String   @unique
  createdAt          DateTime @default(now())
}

/// The provider's subscription statuses, as they arrive. Which of them grant
/// Pro is decided in lib/billing/access.ts, not here.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  PAUSED
  CANCELED
}

/// A mirror of one provider subscription, written only from provider data
/// (webhook events, the reconcile, the answer to a cancel). Events arrive
/// out of order and repeat, so a write applies only when the provider's
/// `updated_at` is newer than `providerUpdatedAt`.
model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerSubscriptionId String             @unique
  status                 SubscriptionStatus
  /// Our catalog key for what is subscribed ("pro_monthly"), or "unknown".
  priceKey               String
  /// The current billing period, Pro's quota period. Null while paused or canceled.
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  /// A cancellation scheduled for the end of the period: Pro stays until then.
  cancelAtPeriodEnd      Boolean            @default(false)
  /// When the scheduled change takes effect.
  scheduledChangeAt      DateTime?
  canceledAt             DateTime?
  /// The provider's last-modified time of the subscription: the ordering key.
  providerUpdatedAt      DateTime
  /// When the lazy reconcile last asked the provider about this row; throttles it.
  reconcileCheckedAt     DateTime?
  /// The provider's transaction that created this subscription (the checkout
  /// the user paid), from the created event or the completed transaction:
  /// how the account page knows that the checkout it waits for has landed.
  transactionId          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
}

/// Every provider event the webhook accepted, by the provider's event id:
/// the idempotency key and the audit trail. Type, ids and times only; no
/// payload, no personal data. A claimed but unprocessed row (the handler
/// crashed) may be claimed again after a while; a processed one never is.
model BillingEvent {
  providerEventId String    @id
  type            String
  occurredAt      DateTime
  claimedAt       DateTime?
  processedAt     DateTime?
  /// The user the event was applied to, when it mapped to one. Not a foreign
  /// key: the trail outlives the account.
  userId          String?
  receivedAt      DateTime  @default(now())

  @@index([occurredAt])
}

/// Fixed-window rate limiting in Postgres: one row per user, action and
/// window, incremented atomically by an upsert. Old windows of a key are
/// deleted on the key's next hit, so the table never grows past the live
/// windows.
model RateLimitCounter {
  /// `{userId}:{action}`.
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

/// Which agent an interview was issued on, and so how long it may run.
enum InterviewTier {
  TRIAL
  FULL
}

model ResumeAnalysis {
  id             String   @id @default(uuid())
  companyName    String
  jobTitle       String
  jobDescription String
  /// Storage key of the CV, `cv/{userId}/{uuid}.pdf`, in the private bucket.
  /// Never a URL: reads are signed on demand, for minutes.
  resumeKey      String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  /// What the analysis guardrail did to the model's answer: intervention
  /// counts and the edits themselves (`guardStatsSchema`). Read by
  /// `npm run report:guards`; null on rows from before it was recorded.
  guardStats     Json?

  feedback   ResumeFeedback?
  /// Every rehearsal of this analysis, numbered by `attemptNumber`.
  interviews Interview[]

  @@index([userId, createdAt])
}

model ResumeFeedback {
  id                         String         @id @default(uuid())
  resumeId                   String         @unique
  resume                     ResumeAnalysis @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  overall                    Json
  atsCompatibility           Json
  experienceAndImpact        Json
  skills                     Json
  educationAndCertifications Json
  toneAndClarity             Json
  jobFit                     Json
}

/// Lifecycle of a voice interview.
///
///   SCHEDULED        created, never started
///   IN_PROGRESS      a session was issued; no scoreable transcript yet. Still
///                    startable (a dropped call, or an attempt where the
///                    candidate never spoke), bounded by `startCount`
///   FEEDBACK_PENDING the transcript arrived with candidate turns; feedback
///                    generation has not run, or failed once and may retry
///   GENERATING       a generator claimed the row; a claim older than
///                    FEEDBACK_CLAIM_STALE_MS can be taken over
///   COMPLETED        feedback stored
///   FAILED           attempts exhausted without a scoreable transcript, or
///                    feedback generation gave up (see `failureReason`)
///   EXPIRED          reserved for a never-started interview past its window
/// What paid for an interview's unit: one of a Pro's period interviews, a pack
/// credit, or the lifetime trial. Set with the first token, beside the usage
/// event; what a refund gives back and what support reads.
enum InterviewPaidBy {
  PERIOD
  CREDIT
  TRIAL
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  FEEDBACK_PENDING
  GENERATING
  COMPLETED
  FAILED
  EXPIRED
}

model Interview {
  id           String          @id @default(uuid())
  role         String
  techstack    String[]
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       InterviewStatus @default(SCHEDULED)
  createdAt    DateTime        @default(now())

  /// The conversation the stored transcript came from, or, before one is
  /// stored, the latest issued session. Unique so one conversation can only
  /// ever land on one interview; also the id the reconcile path fetches.
  conversationId String? @unique
  /// Every conversation id the session endpoint has issued for this
  /// interview. The webhook and the reconcile path match a delivery on
  /// membership here, so a second session issued while a call is still live
  /// cannot orphan the first call's transcript.
  issuedConversationIds String[] @default([])
  /// Transcript turns, verbatim from the post-call webhook.
  transcript     Json?
  /// Where the transcript came from. Only "elevenlabs" (the signed webhook)
  /// is written since M3-C; rows scored from the old browser-supplied
  /// transcript carry "browser".
  transcriptSource String?
  /// The dynamic variables the server issued for the latest session. What the
  /// browser passes to the agent is compared against this.
  issuedContext  Json?
  /// True when the post-call payload's initiation data differed from
  /// `issuedContext`: the browser tampered with its own session.
  contextMismatch Boolean @default(false)
  /// Why the latest step produced nothing: NO_CANDIDATE_TURNS,
  /// SESSION_LOST, CONTEXT_MISSING, TRANSCRIPT_INVALID or FEEDBACK_FAILED.
  failureReason   String?

  startedAt       DateTime?
  /// When the latest session was issued (`startedAt` keeps the first). An
  /// IN_PROGRESS interview with starts left and no session for
  /// INTERVIEW_ABANDON_MS is expired lazily and its unit given back.
  lastSessionAt   DateTime?
  /// First written by the room's end-of-call report (a hint that shortens
  /// the reconcile window), then overwritten by the platform's value when the
  /// transcript arrives. Cleared when a new session is issued.
  endedAt         DateTime?
  durationSeconds Int?
  /// Sessions issued for this interview. Capped by the session endpoint:
  /// every start is a paid call.
  startCount      Int       @default(0)
  /// The usage event reserved on the first token, never on creation and
  /// never on a reconnect. Null until then; refunded if the interview ends
  /// without a candidate turn.
  usageEventId    String?   @unique
  /// Which source paid for the unit in `usageEventId`; kept after a refund so
  /// support can tell what went back. Overwritten by the next reservation.
  paidBy          InterviewPaidBy?
  /// Set with the first token: which agent, and so which duration, this
  /// interview runs on. Reconnects reuse it; the feedback is judged against it.
  tier            InterviewTier?
  /// When the reconcile fallback last asked the platform about the latest
  /// session. A conditional update on it throttles the fallback to one
  /// platform call per minute per interview, however many tabs poll.
  reconcileCheckedAt DateTime?
  /// Feedback generation claims so far; the generator gives up after two.
  feedbackAttempts  Int       @default(0)
  /// When the current GENERATING claim was taken, to detect a dead worker.
  feedbackStartedAt DateTime?

  resumeAnalysisId String?
  /// Deleting an analysis deletes its rehearsals and their feedback with it:
  /// the feedback is judged against that analysis and means nothing without
  /// it. The deletion routine refuses while a rehearsal is live.
  resumeAnalysis   ResumeAnalysis? @relation(fields: [resumeAnalysisId], references: [id], onDelete: Cascade)
  /// 1 for the first rehearsal of an analysis, 2 for the next. Unique per
  /// analysis, so two creates racing for the same number cannot both land.
  attemptNumber    Int             @default(1)

  InterviewFeedback InterviewFeedback?

  @@unique([resumeAnalysisId, attemptNumber])
  @@index([userId, createdAt])
}

model InterviewFeedback {
  id          String    @id @default(uuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  /// Mean of the category scores, kept as a column for lists.
  totalScore  Int
  /// The whole feedback, validated by `interviewFeedbackReportSchema` on read:
  /// gap follow-through, notable answers, category scores, anchored
  /// strengths and areas, computed interview stats, final assessment. Json so
  /// the shape can move with the prompt; a row that fails the schema reads
  /// as no feedback.
  report      Json?
  /// What the feedback guardrail did to the model's answer (`guardStatsSchema`);
  /// null on rows from before it was recorded. The report reads the daily
  /// aggregate below, not this.
  guardStats  Json?
  /// When the feedback was stored; rows from before the column were dated
  /// from their interview's end (or creation) by the migration.
  createdAt   DateTime  @default(now())
}

/// Which guardrail a daily tally belongs to.
enum GuardKind {
  ANALYSIS
  INTERVIEW
}

/// Anonymous daily tallies of what the two guardrails did, incremented in
/// the same transaction that stores a row's `guardStats` and never deleted:
/// the per-row stats go with their account, the quality signal stays. Each
/// (check, action) pair counts interventions; the pair ("rows", "recorded")
/// counts rows that stored stats and ("rows", "fired") the rows where
/// anything fired. Read by `npm run report:guards`. No user id, by design.
model GuardStatDaily {
  date   DateTime  @db.Date
  kind   GuardKind
  check  String
  action String
  count  Int       @default(0)

  @@id([date, kind, check, action])
}
