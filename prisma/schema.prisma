datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ResumeAnalysis {
  id          String   @id @default(uuid())
  companyName String
  jobTitle    String
  resumeUrl   String
  createdAt   DateTime @default(now())

  feedback Feedback?
}

model Feedback {
  id                         String         @id @default(uuid())
  resumeId                   String         @unique
  resume                     ResumeAnalysis @relation(fields: [resumeId], references: [id])
  overall                    Json
  atsCompatibility           Json
  experienceAndImpact        Json
  skills                     Json
  educationAndCertifications Json
  toneAndClarity             Json
  jobFit                     Json
}
