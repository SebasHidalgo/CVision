datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Resume {
  id             String   @id @default(uuid())
  companyName    String
  jobTitle       String
  resumeUrl      String
  resumeImageUrl String
  createdAt      DateTime @default(now())

  feedback Feedback? @relation("ResumeFeedback")
}

model Feedback {
  id                      String @id @default(uuid())
  resumeId                String @unique
  resume                  Resume @relation("ResumeFeedback", fields: [resumeId], references: [id])
  overall                 Json
  atsCompatibility        Json
  experience              Json
  education               Json
  skills                  Json
  toneAndLanguage         Json
  jobDescriptionAlignment Json
}
