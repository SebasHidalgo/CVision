NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supavisor transaction pooler (port 6543, ?pgbouncer=true) — used at runtime
DATABASE_URL=
# Direct connection (port 5432) — Prisma CLI only
DIRECT_URL=

NEXT_PUBLIC_SUPABASE_URL=
# Read as NEXT_PUBLIC_SUPABASE_KEY in code, not ..._ANON_KEY
NEXT_PUBLIC_SUPABASE_KEY=

NEXT_PUBLIC_VAPI_KEY=

# AI (text): resume analysis, techstack extraction, interview feedback.
# Only "google" is wired today; lib/ai/client.ts is the one place to extend.
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite
# Sampling is pinned in lib/ai/client.ts (temperature 0, a fixed seed), so
# the same CV and posting return the same analysis. Leave both unset in
# production. They exist for `npm run eval`: AI_TEMPERATURE=provider sends no
# temperature at all and AI_SEED=none sends no seed, which is how to capture
# a spread of draws when a change has to be judged on an average.
# AI_TEMPERATURE=
# AI_SEED=
# Google AI Studio key. Server-only; also needed by `npm run eval`.
GOOGLE_GENERATIVE_AI_API_KEY=
