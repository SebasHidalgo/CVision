NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supavisor transaction pooler (port 6543, ?pgbouncer=true) — used at runtime
DATABASE_URL=
# Direct connection (port 5432) — Prisma CLI only
DIRECT_URL=

# Project URL. Read on the server only; nothing in the browser talks to
# Supabase directly (uploads and reads go through URLs the server signs).
NEXT_PUBLIC_SUPABASE_URL=
# Service role (Project Settings > API > service_role, the one marked secret).
# Server-only, bypasses the bucket's policies: never with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Voice interview (ElevenLabs Agents). All three are server-only: the browser
# gets a short-lived conversation token from /api/interview/[id]/session,
# never the key. `npm run agent:sync` creates the agent (leave AGENT_ID empty
# the first time, then paste the id it prints) and, with --webhook-url, the
# post-call webhook, printing its secret once.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# AI (text): resume analysis and interview feedback.
# Only "google" is wired today; lib/ai/client.ts is the one place to extend.
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite
# Sampling is pinned in lib/ai/client.ts (temperature 0, a fixed seed), so
# the same CV and posting return the same analysis. Leave both unset in
# production. They exist for `npm run eval`: AI_TEMPERATURE=provider sends no
# temperature at all and AI_SEED=none sends no seed, which is how to capture
# a spread of draws when a change has to be judged on an average.
# AI_TEMPERATURE=
# AI_SEED=
# Google AI Studio key. Server-only; also needed by `npm run eval`.
GOOGLE_GENERATIVE_AI_API_KEY=
